{
  "name": "carrel",
  "compatibility_date": "2026-10-04",
  "workers_dev": false,
  "preview_urls": false,
  // The site's only address. Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "carrel.zenithal.co.uk", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
