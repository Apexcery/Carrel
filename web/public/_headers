# Security headers for every page and file Cloudflare serves (https://developers.cloudflare.com/workers/static-assets/headers/).
# The Content Security Policy only allows Carrel's own scripts and styles, images from the book sources' cover servers,
# and connections to Carrel's API, Supabase, and GitHub's API (the Android app's release notes). Checked against the
# live site in report-only mode before enforcing.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://iirzotkuqblvyfvjwuta.supabase.co https://assets.hardcover.app https://covers.openlibrary.org https://archive.org https://*.archive.org; font-src 'self'; connect-src 'self' https://carrel-api-3344660708.europe-west1.run.app https://iirzotkuqblvyfvjwuta.supabase.co https://api.github.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

# The eReader's page has its own policy in place of the one above (rules matching a path are combined, so it's taken
# off first). Readium shows each chapter in a blob: frame, which inherits this policy, and runs its own scripts in them
# as blob: URLs. Book scripts are stripped from each chapter, and inline ones are blocked here as well. Books' own styles
# are mostly inline, hence 'unsafe-inline' for styles only. Online libraries are browsed on this page too, and can be
# any https:// server the reader adds, hence https: for connections (and their covers come as blob: pictures).
/read/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' blob:; style-src 'self' blob: 'unsafe-inline'; img-src 'self' data: blob: https://iirzotkuqblvyfvjwuta.supabase.co https://assets.hardcover.app https://covers.openlibrary.org https://archive.org https://*.archive.org; font-src 'self' data: blob:; media-src blob:; frame-src blob:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
